<?xml version="1.0" encoding="UTF-8" ?>
<Window
    x:Class="AppSandbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" RowDefinitions="Auto,*">
        <TitleBar x:Name="AppTitleBar"
                  Title="App Sandbox"
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.targetsize-32_altform-unplated.png" />
            </TitleBar.IconSource>

            <!-- How many VMs run, readable from every page. Hidden when none does. -->
            <TitleBar.RightHeader>
                <Border x:Name="RunningBadge"
                        Visibility="Collapsed"
                        Margin="0,0,8,0"
                        Style="{StaticResource StatusPillStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="RunningText" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="True"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="701"
                        ExpandedModeThresholdWidth="701"
                        SelectionChanged="NavView_SelectionChanged"
                        ItemInvoked="NavView_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Virtual machines" Tag="library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="VmCountBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Activity" Tag="activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- What the running VMs take from this PC. Only with the pane open:
                 folded to icons there is no room for it. -->
            <NavigationView.PaneFooter>
                <Border x:Name="HostCard"
                        Margin="12,0,12,8"
                        Padding="12"
                        Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="In use by running VMs"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Spacing="3">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Processors" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="HostCpuText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <ProgressBar x:Name="HostCpuBar" Maximum="1" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Memory" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="HostRamText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <ProgressBar x:Name="HostRamBar" Maximum="1" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Free disk" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="HostDiskText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <TextBlock Text="GPU" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="HostGpuText" Grid.Column="1" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <Grid RowDefinitions="Auto,Auto,*">
                <!-- The app is shutting its VMs down in order to exit. -->
                <InfoBar x:Name="ExitBar"
                         Margin="36,16,36,0"
                         IsOpen="False"
                         IsClosable="False"
                         Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button x:Name="ExitCancelButton" Content="Don't exit" Click="ExitCancel_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- One place for news from the host: what was done, what could not be. -->
                <InfoBar x:Name="NoticeBar"
                         Grid.Row="1"
                         Margin="36,16,36,0"
                         IsOpen="False"
                         IsClosable="True" />

                <Frame x:Name="ContentFrame" Grid.Row="2" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
