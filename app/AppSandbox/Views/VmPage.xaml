<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="AppSandbox.Views.VmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="36,24,36,24">
        <StackPanel Spacing="12">

            <!-- Header: back, the VM's tile and name, its state, and what can be done to it now. -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
                <Button Style="{StaticResource SubtleIconButtonStyle}" VerticalAlignment="Center" Click="Back_Click"
                        AutomationProperties.Name="Back to virtual machines" ToolTipService.ToolTip="Back to virtual machines">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <Border Grid.Column="1" Style="{StaticResource PageIconTileStyle}">
                    <Grid>
                        <FontIcon x:Name="OsGlyph" Style="{StaticResource PageIconGlyphStyle}" />
                        <Image x:Name="IconImage" Width="36" Height="36" Stretch="Uniform" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="NameText" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <Border Style="{StaticResource StatusPillStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <ProgressRing x:Name="StatusRing" Width="12" Height="12" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SubText" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="PrimaryButton" MinWidth="104" Click="Primary_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="PrimaryGlyph" FontSize="14" />
                            <TextBlock x:Name="PrimaryText" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShutDownButton" Content="Shut down" Click="ShutDown_Click" />
                    <Button x:Name="MoreButton" Style="{StaticResource IconButtonStyle}" Click="More_Click"
                            AutomationProperties.Name="More actions" ToolTipService.ToolTip="More actions">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <ProgressBar x:Name="Progress" Maximum="100" Visibility="Collapsed" />
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" CloseButtonClick="ErrorBar_Close" />

            <SelectorBar x:Name="Sections" Margin="-12,4,0,0" SelectionChanged="Sections_SelectionChanged">
                <SelectorBarItem Text="Overview" Tag="overview" />
                <SelectorBarItem Text="Hardware" Tag="hardware" />
                <SelectorBarItem x:Name="DisplayTab" Text="Display" Tag="display" />
                <SelectorBarItem x:Name="SnapshotsTab" Text="Snapshots" Tag="snapshots" />
            </SelectorBar>

            <!-- ============================ Overview ============================ -->
            <StackPanel x:Name="OverviewPanel" Spacing="12">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel x:Name="OverviewRows" Spacing="10" />
                </Border>

                <Border x:Name="FilesCard" Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <FontIcon Glyph="&#xE838;" Style="{StaticResource RowGlyphStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Files" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="The VM's disk, snapshots, display settings and icon." Style="{StaticResource RowDescriptionStyle}" />
                            <TextBlock x:Name="FolderText" Style="{StaticResource RowDescriptionStyle}" IsTextSelectionEnabled="True" FontFamily="Cascadia Mono, Consolas" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Open VM folder" Click="OpenFolder_Click" />
                            <Button Content="Copy path" Click="CopyPath_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="ToolsCard" Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <FontIcon Glyph="&#xE895;" Style="{StaticResource RowGlyphStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Guest components" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="ToolsText" Style="{StaticResource RowDescriptionStyle}" />
                        </StackPanel>
                        <Button x:Name="ToolsButton" Grid.Column="2" Content="Update guest components" VerticalAlignment="Center" Click="UpdateTools_Click" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ============================ Hardware ============================ -->
            <StackPanel x:Name="HardwarePanel" Spacing="12" Visibility="Collapsed">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Can be changed while the VM is stopped." Style="{StaticResource RowDescriptionStyle}" VerticalAlignment="Center" />
                            <Button x:Name="EditButton" Grid.Column="1" Click="Edit_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9E9;" FontSize="14" />
                                    <TextBlock Text="Edit hardware" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel x:Name="HardwareRows" Spacing="10" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ Display ============================ -->
            <StackPanel x:Name="DisplayPanel" Spacing="12" Visibility="Collapsed">
                <InfoBar x:Name="DisplayNote" IsOpen="True" IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="DisplayUpdateButton" Content="Update guest components" Click="UpdateTools_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <FontIcon Glyph="&#xE7F4;" Style="{StaticResource RowGlyphStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Resolution" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Adaptive follows the size of the VM window; Fixed keeps one resolution and scales it." Style="{StaticResource RowDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="ResolutionCombo" Grid.Column="2" Width="250" VerticalAlignment="Center" SelectionChanged="Resolution_SelectionChanged" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <FontIcon Glyph="&#xE916;" Style="{StaticResource RowGlyphStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Refresh rate" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="How often the VM draws its screen" Style="{StaticResource RowDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="RateCombo" Grid.Column="2" Width="250" VerticalAlignment="Center" SelectionChanged="Rate_SelectionChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <FontIcon Glyph="&#xE7FC;" Style="{StaticResource RowGlyphStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Streaming mode" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Quality sends exact pixels. Performance has the VM's GPU encode video: smoother in games." Style="{StaticResource RowDescriptionStyle}" />
                                <TextBlock x:Name="StreamNote" Style="{StaticResource RowDescriptionStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="StreamCombo" Grid.Column="2" Width="250" VerticalAlignment="Center" SelectionChanged="Stream_SelectionChanged">
                                <ComboBoxItem Content="Quality" Tag="quality" />
                                <ComboBoxItem Content="Performance (games)" Tag="performance" />
                            </ComboBox>
                        </Grid>
                        <StackPanel x:Name="StreamOptions" Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <FontIcon Glyph="&#xE714;" Style="{StaticResource RowGlyphStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Codec" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="CodecNote" Style="{StaticResource RowDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="CodecCombo" Grid.Column="2" Width="250" VerticalAlignment="Center" SelectionChanged="Codec_SelectionChanged">
                                    <ComboBoxItem Content="Auto" Tag="auto" />
                                    <ComboBoxItem Content="H.264" Tag="h264" />
                                    <ComboBoxItem Content="HEVC (H.265)" Tag="hevc" />
                                </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <FontIcon Glyph="&#xEC4A;" Style="{StaticResource RowGlyphStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Bit rate" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="How much data the picture may use each second" Style="{StaticResource RowDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="BitrateCombo" Grid.Column="2" Width="250" VerticalAlignment="Center" SelectionChanged="Bitrate_SelectionChanged" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource RowDescriptionStyle}"
                           Text="More display options (FPS counter, borderless fullscreen with F11, clipboard, audio) are in the VM window: right-click its title bar." />
            </StackPanel>

            <!-- ============================ Snapshots ============================ -->
            <StackPanel x:Name="SnapshotsPanel" Spacing="12" Visibility="Collapsed">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <FontIcon Glyph="&#xE81C;" Style="{StaticResource RowGlyphStyle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Disks" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="SnapshotCurrent" Style="{StaticResource RowDescriptionStyle}" />
                                <TextBlock x:Name="SnapshotHelp" Style="{StaticResource RowDescriptionStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="SnapshotNew" Content="New snapshot" Click="SnapshotNew_Click" />
                                <Button x:Name="SnapshotRename" Content="Rename" Click="SnapshotRename_Click" />
                                <Button x:Name="SnapshotDelete" Content="Delete" Click="SnapshotDelete_Click" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <!-- The base disk, its snapshots and their branches. The one
                             picked is what the next Start uses. -->
                        <StackPanel x:Name="SnapshotTree" Spacing="2" />
                        <TextBlock x:Name="SnapshotWarn" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Height="32" />
        </StackPanel>
    </ScrollViewer>
</Page>
