<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="AppSandbox.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="36,24,36,24">
        <StackPanel Spacing="12">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Style="{StaticResource PageIconTileStyle}">
                    <FontIcon Glyph="&#xE713;" Style="{StaticResource PageIconGlyphStyle}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="How App Sandbox looks and behaves" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- ───────────── Appearance ───────────── -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,8,0,4">
                <FontIcon Glyph="&#xE790;" Style="{StaticResource SectionGlyphStyle}" />
                <TextBlock Text="APPEARANCE" Grid.Column="1" Style="{StaticResource SectionLabelStyle}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE771;" Style="{StaticResource RowGlyphStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Follow Windows, or pick one" Style="{StaticResource RowDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeCombo" Grid.Column="2" Width="170" VerticalAlignment="Center" SelectionChanged="Appearance_Changed">
                        <ComboBoxItem Content="Use system setting" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE7F4;" Style="{StaticResource RowGlyphStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Window effect" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="The material behind the window" Style="{StaticResource RowDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="BackdropCombo" Grid.Column="2" Width="170" VerticalAlignment="Center" SelectionChanged="Appearance_Changed">
                        <ComboBoxItem Content="Mica" Tag="Mica" />
                        <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                        <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                        <ComboBoxItem Content="None" Tag="None" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ───────────── System ───────────── -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,16,0,4">
                <FontIcon Glyph="&#xE713;" Style="{StaticResource SectionGlyphStyle}" />
                <TextBlock Text="SYSTEM" Grid.Column="1" Style="{StaticResource SectionLabelStyle}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE921;" Style="{StaticResource RowGlyphStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="When closing the window with VMs running" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Exiting App Sandbox turns its VMs off; in the notification area they keep running" Style="{StaticResource RowDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="CloseCombo" Grid.Column="2" Width="240" VerticalAlignment="Center" SelectionChanged="Close_Changed">
                        <ComboBoxItem Content="Ask every time" Tag="ask" />
                        <ComboBoxItem Content="Keep running in the tray" Tag="tray" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ───────────── Virtual machines ───────────── -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,16,0,4">
                <FontIcon Glyph="&#xE7F4;" Style="{StaticResource SectionGlyphStyle}" />
                <TextBlock Text="VIRTUAL MACHINES" Grid.Column="1" Style="{StaticResource SectionLabelStyle}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE895;" Style="{StaticResource RowGlyphStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Update guest components automatically" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Before a Windows VM starts, copy in this version's agent, helpers and display driver when they are newer" Style="{StaticResource RowDescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoUpdateToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="AutoUpdate_Toggled" />
                </Grid>
            </Border>

            <!-- ───────────── VM windows ───────────── -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,16,0,4">
                <FontIcon Glyph="&#xE8A7;" Style="{StaticResource SectionGlyphStyle}" />
                <TextBlock Text="VM WINDOWS" Grid.Column="1" Style="{StaticResource SectionLabelStyle}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE9D9;" Style="{StaticResource RowGlyphStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Show resolution and FPS in the title bar" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Of every VM window" Style="{StaticResource RowDescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="TitleStatsToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="Viewer_Changed" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE7C4;" Style="{StaticResource RowGlyphStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Floating toolbar" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Fullscreen, display options and shut down at the top of the VM window" Style="{StaticResource RowDescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ToolbarToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="Viewer_Changed" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE950;" Style="{StaticResource RowGlyphStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Renderer" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="What draws the VM's picture on this PC; applies to windows opened from now on" Style="{StaticResource RowDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="RendererCombo" Grid.Column="2" Width="170" VerticalAlignment="Center" SelectionChanged="Viewer_Changed">
                        <ComboBoxItem Content="Direct3D 11" Tag="11" />
                        <ComboBoxItem Content="Direct3D 12" Tag="12" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ───────────── AI agents (MCP) ───────────── -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,16,0,4">
                <FontIcon Glyph="&#xE99A;" Style="{StaticResource SectionGlyphStyle}" />
                <TextBlock Text="AI AGENTS (MCP)" Grid.Column="1" Style="{StaticResource SectionLabelStyle}" />
            </Grid>
            <StackPanel x:Name="McpRows" />

            <!-- ───────────── This computer ───────────── -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,16,0,4">
                <FontIcon Glyph="&#xE977;" Style="{StaticResource SectionGlyphStyle}" />
                <TextBlock Text="THIS COMPUTER" Grid.Column="1" Style="{StaticResource SectionLabelStyle}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel x:Name="ComputerRows" Spacing="10" />
            </Border>

            <!-- ───────────── Folders and logs ───────────── -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,16,0,4">
                <FontIcon Glyph="&#xE838;" Style="{StaticResource SectionGlyphStyle}" />
                <TextBlock Text="FOLDERS AND LOGS" Grid.Column="1" Style="{StaticResource SectionLabelStyle}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE8B7;" Style="{StaticResource RowGlyphStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="VmFolderTitle" Text="Default VM folder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="VmFolderText" Style="{StaticResource RowDescriptionStyle}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Open" Tag="vms" VerticalAlignment="Center" Click="OpenFolder_Click" />
                </Grid>
            </Border>

            <Border x:Name="DataFolderCard" Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE8F1;" Style="{StaticResource RowGlyphStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="App Sandbox data" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="DataFolderText" Style="{StaticResource RowDescriptionStyle}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Open" Tag="data" VerticalAlignment="Center" Click="OpenFolder_Click" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE9D9;" Style="{StaticResource RowGlyphStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Activity log" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="LogFileText" Style="{StaticResource RowDescriptionStyle}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Show in folder" Tag="log" VerticalAlignment="Center" Click="OpenFolder_Click" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xEBE8;" Style="{StaticResource RowGlyphStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Diagnostic info" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Version, Windows build, GPUs and VM states for a bug report; no passwords or account names" Style="{StaticResource RowDescriptionStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Copy" VerticalAlignment="Center" Click="CopyDiagnostics_Click" />
                </Grid>
            </Border>

            <!-- ───────────── About ───────────── -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,16,0,4">
                <FontIcon Glyph="&#xE946;" Style="{StaticResource SectionGlyphStyle}" />
                <TextBlock Text="ABOUT" Grid.Column="1" Style="{StaticResource SectionLabelStyle}" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="24">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-256_altform-unplated.png" Width="56" Height="56" Stretch="Uniform" />
                    <TextBlock Text="App Sandbox" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Virtual machines with GPU acceleration for Windows 11"
                               Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8" />
                    <TextBlock x:Name="LicenseText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE8A5;" Style="{StaticResource RowGlyphStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="License" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="MIT License, and the notices of the components App Sandbox ships" Style="{StaticResource RowDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="License" Tag="license" Click="Document_Click" />
                        <Button Content="Third-party notices" Tag="notices" Click="Document_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE774;" Style="{StaticResource RowGlyphStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Project page" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="ProjectText" Style="{StaticResource RowDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <HyperlinkButton Content="Releases" Tag="releases" Click="Link_Click" />
                        <HyperlinkButton Content="Report a problem" Tag="issues" Click="Link_Click" />
                        <HyperlinkButton Content="Open" Tag="project" Click="Link_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Height="32" />
        </StackPanel>
    </ScrollViewer>
</Page>
