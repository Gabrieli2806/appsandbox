<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="AppSandbox.Views.VmCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One VM in the list: what it is, what state it is in, and the one thing
         most likely wanted next (Start or Connect). The rest is in the menu
         and on the VM's own page, which the card opens. -->
    <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Style="{StaticResource VmTileStyle}">
                    <Grid>
                        <FontIcon x:Name="OsGlyph" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Image x:Name="IconImage" Width="32" Height="32" Stretch="Uniform" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                        <HyperlinkButton x:Name="NameLink" Padding="0" Click="Open_Click">
                            <TextBlock x:Name="NameText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        </HyperlinkButton>
                        <Border x:Name="StatusPill" Grid.Column="1" Style="{StaticResource StatusPillStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <ProgressRing x:Name="StatusRing" Width="12" Height="12" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="SubText" Style="{StaticResource RowDescriptionStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="6" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="PrimaryButton" MinWidth="104" Click="Primary_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="PrimaryGlyph" FontSize="14" />
                            <TextBlock x:Name="PrimaryText" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SshButton" Style="{StaticResource IconButtonStyle}" Click="Ssh_Click" Visibility="Collapsed"
                            AutomationProperties.Name="Open an SSH terminal">
                        <FontIcon Glyph="&#xE756;" FontSize="16" />
                    </Button>
                    <Button x:Name="EditButton" Style="{StaticResource IconButtonStyle}" Click="Edit_Click"
                            AutomationProperties.Name="Edit hardware" ToolTipService.ToolTip="Edit hardware (VM must be stopped)">
                        <FontIcon Glyph="&#xE9E9;" FontSize="16" />
                    </Button>
                    <Button x:Name="MoreButton" Style="{StaticResource IconButtonStyle}" Click="More_Click"
                            AutomationProperties.Name="More actions" ToolTipService.ToolTip="More actions">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- The disk the next start uses, when the VM has snapshots. -->
            <TextBlock x:Name="DiskText" Style="{StaticResource RowDescriptionStyle}" Visibility="Collapsed" />

            <ProgressBar x:Name="Progress" Maximum="100" Visibility="Collapsed" />

            <!-- Why the last start, shutdown or delete did not work. -->
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" CloseButtonClick="ErrorBar_Close" />
        </StackPanel>
    </Border>
</UserControl>
