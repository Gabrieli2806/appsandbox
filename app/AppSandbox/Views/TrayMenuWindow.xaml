<?xml version="1.0" encoding="UTF-8" ?>
<Window x:Class="AppSandbox.Views.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The notification-area menu, as a window: a classic popup menu cannot
         show which VMs run and what state each is in, which is what is worth
         seeing from the tray. -->
    <Border x:Name="Root" Padding="8" CornerRadius="8" Background="Transparent">
        <!-- Subtle buttons: a disabled one fades out instead of turning into a grey box. -->
        <Border.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
        </Border.Resources>
        <StackPanel Spacing="2">

            <Grid Margin="6,4,6,8" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Grid Width="30" Height="30" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusHalo" Opacity="0.18" />
                    <FontIcon x:Name="StatusGlyph" FontSize="15" Glyph="&#xE7F4;" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="StatusDetail" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- One block per running VM: its name and state, then what can be
                 done to it from here. Filled in code. -->
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="VmRows" Spacing="2" />
            </ScrollViewer>

            <Border Height="1" Margin="0,6,0,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Button Style="{StaticResource TrayMenuItemStyle}" Click="Open_Click">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                    <TextBlock Text="Open App Sandbox" Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Style="{StaticResource TrayMenuItemStyle}" Click="Settings_Click">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                    <TextBlock Text="Settings" Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Border Height="1" Margin="0,6,0,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Button Style="{StaticResource TrayMenuItemStyle}" Click="Exit_Click">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <FontIcon Glyph="&#xE7E8;" FontSize="16" />
                    <TextBlock Text="Quit App Sandbox" Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>
